use("renta_videos");

// 1. Mostrar todos los clientes
print("LISTA DE CLIENTES");
db.clientes.find().forEach(printjson);

// 2. Mostrar todas las peliculas
print("CATALOGO DE PELICULAS");
db.peliculas.find().forEach(printjson);

// 3. Peliculas disponibles
print("PELICULAS DISPONIBLES");
db.peliculas.find({
  disponible: true
}).forEach(printjson);

// 4. Buscar peliculas de accion
print("PELICULAS DE ACCION");
db.peliculas.find({
  genero: "Accion"
}).forEach(printjson);

// 5. Consultar alquileres activos
print("ALQUILERES ACTIVOS");
db.alquileres.find({
  estado: "Alquilado"
}).forEach(printjson);

// 6. Consultar alquileres de un cliente
print("ALQUILERES DEL CLIENTE 1");
db.alquileres.find({
  clienteId: 1
}).forEach(printjson);

// 7. Mostrar alquileres con informacion del cliente
print("ALQUILERES CON DATOS DEL CLIENTE");

db.alquileres.aggregate([
  {
    $lookup: {
      from: "clientes",
      localField: "clienteId",
      foreignField: "_id",
      as: "cliente"
    }
  },
  {
    $unwind: "$cliente"
  },
  {
    $project: {
      _id: 1,
      peliculaId: 1,
      estado: 1,
      monto: 1,
      nombreCliente: "$cliente.nombre"
    }
  }
]).forEach(printjson);

// 8. Total de alquileres por estado
db.alquileres.aggregate([
  {
    $group: {
      _id: "$estado",
      cantidad: { $sum: 1 }
    }
  }
]).forEach(printjson);

use("renta_videos");

// Actualizar telefono de un cliente
db.clientes.updateOne(
  { _id: 1 },
  { $set: { telefono: "71112222" } }
);

// Cambiar disponibilidad de una pelicula
db.peliculas.updateOne(
  { _id: 1 },
  { $set: { disponible: false } }
);

// Registrar devolucion de alquiler
db.alquileres.updateOne(
  { _id: 1 },
  { $set: { estado: "Devuelto" } }
);

print("Actualizaciones realizadas correctamente");

use("renta_videos");

// Eliminar un cliente de prueba
db.clientes.deleteOne({
  _id: 99
});

// Eliminar una pelicula de prueba
db.peliculas.deleteOne({
  _id: 99
});

print("Operaciones de eliminacion ejecutadas");